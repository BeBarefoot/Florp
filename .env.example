# Backend: copy to apps/api/.env or export in shell
DATABASE_URL=sqlite:///./data/florp.db
STORAGE_PATH=./data/storage
CORS_ORIGINS=http://localhost:3000
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_MAX_COMPLETION_TOKENS=8192
LLM_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=fal-ai/flux-control-lora-depth
FAL_API_BASE=https://queue.fal.run
WALL_SEGMENTATION_PROVIDER=yytsi
YYTSI_RUN_DIR=./models/yytsi
YYTSI_CHECKPOINT=best.safetensors
YYTSI_DEVICE=auto
SEGMENTATION_MULTISCALE=true
SEGMENTATION_TILE_SIZE=448
SEGMENTATION_TILE_OVERLAP=0.30
SEGMENTATION_MAX_TILES=64
SEGMENTATION_WALL_THRESHOLD=0.46
WALL_SEGMENTATION_WEIGHTS=
PRETRAINED_YOLO_WEIGHTS=
MAX_UPLOAD_MB=20
# Frontend: copy to apps/web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000

# Inference-only white border; source preview coordinates remain unchanged
INFERENCE_BORDER_ENABLED=true
INFERENCE_BORDER_FRACTION=0.12
INFERENCE_BORDER_MIN_PX=32


# Raster2Seq (experimental; checkpoint CC BY-NC 4.0, evaluation only)
# Requires isolated upstream Linux/CUDA Python environment, not apps/api/.venv.
RASTER2SEQ_ENABLED=false
RASTER2SEQ_ROOT=
RASTER2SEQ_PYTHON=
RASTER2SEQ_DEVICE=cuda
RASTER2SEQ_CHECKPOINT=hf:cubicasa5k
RASTER2SEQ_TIMEOUT_SECONDS=600
